<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Downloading - <%= png.title %></title>
    
    <!-- Google AdSense Verification Script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7255970085689700" crossorigin="anonymous"></script>
    
    <!-- 💡 Adsterra Popunder Code (Sirf Download page par active rahega) -->
    <script src="https://pl30886548.effectivecpmnetwork.com/5f/0e/73/5f0e73345976b0c1ef4f5de8e43992f1.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-50 flex flex-col items-center justify-center min-h-screen p-4">

    <div class="bg-white p-6 rounded-2xl shadow-xl max-w-lg w-full text-center">
        <h2 class="text-2xl font-bold text-gray-800 mb-1">Preparing Your Download</h2>
        <p class="text-gray-500 text-sm mb-4"><%= png.title %></p>

        <!-- DOWNLOAD PAGE BANNER (300x250) -->
        <div class="my-4 p-2 bg-gray-100 rounded-xl border border-dashed border-gray-400 flex justify-center">
            <script>
                atOptions = {
                    'key' : 'ff9c442a05915132043d0fe8a50b5dfe',
                    'format' : 'iframe',
                    'height' : 250,
                    'width' : 300,
                    'params' : {}
                };
            </script>
            <script src="https://www.highperformanceformat.com/ff9c442a05915132043d0fe8a50b5dfe/invoke.js"></script>
        </div>

        <div class="my-6 p-4 bg-gray-50 rounded-xl border border-gray-200 inline-block">
            <img src="<%= png.imageUrl %>" alt="<%= png.title %>" class="h-36 mx-auto object-contain">
        </div>

        <p id="status" class="text-green-600 font-medium mb-4">Your download is starting automatically...</p>

        <a href="/download/<%= png._id %>" id="downloadBtn" class="block w-full bg-blue-600 text-white py-3 rounded-xl font-bold hover:bg-blue-700 shadow-lg transition">Click Here If Download Doesn't Start</a>
        
        <a href="/" class="block mt-4 text-gray-600 text-sm hover:underline">← Back to Home Page</a>
    </div>

    <!-- Social Bar Script -->
    <script src="https://pl30886549.effectivecpmnetwork.com/0b/9b/41/0b9b415dd8b5e65e9d94aa964cfd1e44.js"></script>

    <script>
        setTimeout(() => {
            window.location.href = "/download/<%= png._id %>";
            document.getElementById('status').innerText = "Download Started Successfully!";
        }, 1500);
    </script>
</body>
</html>