<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Downloading - <%= png.title %></title>
    <!-- 💡 Google AdSense Verification Script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7255970085689700" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-50 flex flex-col items-center justify-center min-h-screen p-4">

    <div class="bg-white p-6 rounded-2xl shadow-xl max-w-lg w-full text-center">
        <h2 class="text-2xl font-bold text-gray-800 mb-1">Preparing Your Download</h2>
        <p class="text-gray-500 text-sm mb-4"><%= png.title %></p>

        <!-- Ad Code Space -->
        <div class="my-4 p-6 bg-gray-100 rounded-xl border border-dashed border-gray-400 text-gray-400 text-sm">
            [ Your Ad Code / Banner Space Here ]
        </div>

        <div class="my-6 p-4 bg-gray-50 rounded-xl border border-gray-200 inline-block">
            <img src="<%= png.imageUrl %>" alt="<%= png.title %>" class="h-36 mx-auto object-contain">
        </div>

        <p id="status" class="text-green-600 font-medium mb-4">Your download is starting automatically...</p>

        <a href="<%= png.imageUrl %>" id="downloadBtn" download="<%= png.title %>.png" class="block w-full bg-blue-600 text-white py-3 rounded-xl font-bold hover:bg-blue-700 shadow-lg transition">Click Here If Download Doesn't Start</a>
        
        <a href="/" class="block mt-4 text-gray-600 text-sm hover:underline">← Back to Home Page</a>
    </div>

    <script>
        setTimeout(() => {
            const link = document.createElement('a');
            link.href = "<%= png.imageUrl %>";
            link.download = "<%= png.title %>.png";
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            document.getElementById('status').innerText = "Download Started Successfully!";
        }, 800);
    </script>
</body>
</html>