<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= png.title %> - FreeTransPNG</title>
    
    <!-- Google AdSense Verification Script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7255970085689700" crossorigin="anonymous"></script>

    <link rel="icon" href="/logo.png" type="image/png">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .checkerboard-bg {
            background-image: linear-gradient(45deg, #e5e7eb 25%, transparent 25%), 
                              linear-gradient(-45deg, #e5e7eb 25%, transparent 25%), 
                              linear-gradient(45deg, transparent 75%, #e5e7eb 75%), 
                              linear-gradient(-45deg, transparent 75%, #e5e7eb 75%);
            background-size: 16px 16px;
            background-position: 0 0, 0 8px, 8px -8px, -8px 0px;
        }
    </style>
</head>
<body class="bg-gray-50 font-sans">

    <!-- Header -->
    <header class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white shadow-md">
        <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
            <a href="/" class="flex items-center space-x-2">
                <img src="/logo.png" alt="Logo" class="h-10 w-10 object-contain">
                <span class="text-xl font-bold">Free<span class="text-yellow-300">TransPNG</span></span>
            </a>
            <a href="/" class="text-sm bg-white/10 px-4 py-2 rounded-lg hover:bg-white/20 transition">← Back to Home</a>
        </div>
    </header>

    <!-- Product Detail Section -->
    <main class="max-w-5xl mx-auto px-4 py-8">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 grid grid-cols-1 md:grid-cols-2 gap-6 p-6 items-center">
            
            <div class="checkerboard-bg rounded-xl p-6 flex items-center justify-center relative min-h-[300px]">
                <img src="<%= getWatermarkedUrl(png.imageUrl) %>" alt="<%= png.title %>" class="max-h-72 max-w-full object-contain relative z-10">
            </div>

            <div>
                <span class="bg-indigo-50 text-indigo-600 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider"><%= png.category %></span>
                <h1 class="text-2xl font-extrabold text-gray-800 mt-2"><%= png.title %></h1>
                <p class="text-gray-500 text-xs mt-1">Tags: <%= png.tags %></p>
                
                <div class="mt-4 flex items-center space-x-4 text-xs text-gray-500">
                    <span>✨ Format: <b>HD Transparent PNG</b></span>
                </div>

                <div class="mt-6">
                    <!-- Jab yahan click hoga tab user download page par jayega jahan popunder aayega -->
                    <a href="/download/<%= png._id %>" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-xl text-center shadow-md transition block text-sm">
                        📥 Download HD PNG
                    </a>
                </div>
            </div>
        </div>

        <!-- DETAIL PAGE BANNER (300x250) -->
        <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 text-center mt-6 flex justify-center">
            <script>
                atOptions = {
                    'key' : 'ff9c442a05915132043d0fe8a50b5dfe',
                    'format' : 'iframe',
                    'height' : 250,
                    'width' : 300,
                    'params' : {}
                };
            </script>
            <script src="https://www.highperformanceformat.com/ff9c442a05915132043d0fe8a50b5dfe/invoke.js"></script>
        </div>

        <!-- Recommendations Section (Up to 40 Images) -->
        <% if (recommendations && recommendations.length > 0) { %>
            <div class="mt-12">
                <h3 class="text-lg font-bold text-gray-800 mb-4">Similar Recommendations (Up to 40)</h3>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                    <% recommendations.forEach(item => { %>
                        <div class="bg-white border border-gray-100 rounded-xl overflow-hidden shadow-sm group relative p-3">
                            <a href="/png/<%= item._id %>" class="checkerboard-bg h-32 flex items-center justify-center relative overflow-hidden block rounded-lg p-2">
                                <img src="<%= getWatermarkedUrl(item.imageUrl) %>" alt="<%= item.title %>" class="max-h-24 max-w-full object-contain relative z-10 group-hover:scale-110 transition duration-300">
                                
                                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition duration-200 flex flex-col justify-end p-2 text-white z-25">
                                    <span class="text-[11px] font-bold truncate"><%= item.title %></span>
                                </div>
                            </a>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </main>

    <!-- Social Bar Script -->
    <script src="https://pl30886549.effectivecpmnetwork.com/0b/9b/41/0b9b415dd8b5e65e9d94aa964cfd1e44.js"></script>
</body>
</html>