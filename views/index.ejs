<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreeTransPNG - Free HD Transparent PNG Marketplace</title>
    <link rel="icon" href="/logo.png" type="image/png">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .animated-header {
            background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
            background-size: 400% 400%;
            animation: gradientBG 10s ease infinite;
        }
        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .floating-logo { animation: float 3s ease-in-out infinite; }
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-5px); }
            100% { transform: translateY(0px); }
        }
        .png-card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .png-card:hover { transform: translateY(-3px); box-shadow: 0 6px 15px rgba(0,0,0,0.1); }
    </style>
</head>
<body class="bg-gray-50 font-sans">

    <!-- Header -->
    <header class="animated-header text-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-2.5 flex flex-col md:flex-row items-center justify-between gap-3">
            <a href="/" class="flex items-center space-x-2.5 group">
                <img src="/logo.png" alt="Logo" class="h-10 w-10 object-contain floating-logo">
                <div>
                    <span class="text-xl font-extrabold tracking-wide drop-shadow-md">Free<span class="text-yellow-300">TransPNG</span></span>
                    <p class="text-[10px] text-gray-100">Magic Transparent Gallery</p>
                </div>
            </a>

            <!-- Search with Live Suggestions Dropdown -->
            <div class="relative w-full md:flex-1 max-w-md">
                <form action="/" method="GET" autocomplete="off">
                    <input type="text" id="searchInput" name="search" value="<%= search %>" placeholder="Search by title, tags or category..." class="w-full px-4 py-1.5 rounded-full text-gray-800 focus:outline-none shadow-inner text-xs">
                </form>
                <div id="suggestionsBox" class="absolute left-0 right-0 mt-1 bg-white rounded-xl shadow-xl z-50 hidden border border-gray-100 max-h-60 overflow-y-auto"></div>
            </div>

            <nav class="flex flex-wrap items-center justify-center gap-3 text-xs font-semibold">
                <a href="/" class="hover:text-yellow-200 transition">Home</a>
                <a href="/about" class="hover:text-yellow-200 transition">About</a>
                <a href="/contact" class="hover:text-yellow-200 transition">Contact</a>
                <a href="/privacy" class="hover:text-yellow-200 transition">Privacy</a>
            </nav>
        </div>

        <!-- Categories Bar -->
        <div class="bg-black/20 backdrop-blur-md py-1.5 px-4 border-t border-white/10">
            <div class="max-w-7xl mx-auto flex space-x-3 overflow-x-auto scrollbar-none text-xs items-center">
                <span class="text-yellow-300 font-bold whitespace-nowrap">🔥 Categories:</span>
                <a href="/" class="hover:bg-white/20 px-2.5 py-0.5 rounded-full transition whitespace-nowrap">All</a>
                <% categories.forEach(cat => { %>
                    <a href="/?category=<%= encodeURIComponent(cat.name) %>" class="hover:bg-white/20 px-2.5 py-0.5 rounded-full transition whitespace-nowrap <%= selectedCategory === cat.name ? 'bg-white/30 font-bold' : '' %>">
                        <%= cat.name %>
                    </a>
                <% }) %>
            </div>
        </div>
    </header>

    <!-- Compact Grid Content -->
    <main class="max-w-7xl mx-auto px-4 py-6">
        <h2 class="text-lg font-bold text-gray-800 mb-4 border-b pb-1.5">Explore HD Transparent PNGs</h2>
        
        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-3">
            <% pngs.forEach(png => { %>
                <div class="png-card bg-white border border-gray-100 rounded-xl p-3 flex flex-col justify-between shadow-sm group">
                    <a href="/png/<%= png._id %>" class="bg-gray-100 rounded-lg p-2 h-28 flex items-center justify-center relative overflow-hidden">
                        <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:10px_10px]"></div>
                        <img src="<%= png.imageUrl %>" alt="<%= png.title %>" class="max-h-full max-w-full object-contain relative z-10 group-hover:scale-105 transition duration-200">
                    </a>

                    <div class="mt-2">
                        <span class="text-[10px] text-indigo-600 font-semibold uppercase tracking-wider"><%= png.category %></span>
                        <h3 class="text-xs font-bold text-gray-800 truncate mt-0.5"><%= png.title %></h3>
                    </div>

                    <div class="mt-2 pt-2 border-t border-gray-100 flex items-center justify-between text-[10px]">
                        <span class="text-gray-400"><%= png.downloads %> DLs</span>
                        <a href="/png/<%= png._id %>" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-2 py-1 rounded shadow transition">
                            View
                        </a>
                    </div>
                </div>
            <% }) %>
        </div>
    </main>

    <!-- Live Suggestions Script -->
    <script>
        const searchInput = document.getElementById('searchInput');
        const suggestionsBox = document.getElementById('suggestionsBox');

        searchInput.addEventListener('input', async function() {
            const query = this.value.trim();
            if (query.length < 1) {
                suggestionsBox.classList.add('hidden');
                return;
            }
            try {
                const res = await fetch(`/api/search-suggestions?q=${encodeURIComponent(query)}`);
                const items = await res.json();
                if (items.length > 0) {
                    suggestionsBox.innerHTML = items.map(item => `
                        <a href="/png/${item._id}" class="flex items-center space-x-3 p-2 hover:bg-gray-50 border-b border-gray-50 text-xs text-gray-700">
                            <img src="${item.imageUrl}" class="w-8 h-8 object-contain bg-gray-100 rounded">
                            <div>
                                <div class="font-bold">${item.title}</div>
                                <div class="text-[10px] text-gray-400">Category: ${item.category} | Tags: ${item.tags}</div>
                            </div>
                        </a>
                    `).join('');
                    suggestionsBox.classList.remove('hidden');
                } else {
                    suggestionsBox.classList.add('hidden');
                }
            } catch (err) { console.error(err); }
        });

        document.addEventListener('click', (e) => {
            if (!searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
                suggestionsBox.classList.add('hidden');
            }
        });
    </script>
</body>
</html>