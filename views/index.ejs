<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreeTransPNG - Free HD Transparent PNG Marketplace</title>
    <!-- Favicon Logo -->
    <link rel="icon" href="/logo.png" type="image/png">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .animated-header {
            background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
            background-size: 400% 400%;
            animation: gradientBG 10s ease infinite;
        }
        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .floating-logo {
            animation: float 3s ease-in-out infinite;
        }
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-6px); }
            100% { transform: translateY(0px); }
        }
        .png-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .png-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.12);
        }
    </style>
</head>
<body class="bg-gray-50 font-sans">

    <!-- Header -->
    <header class="animated-header text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-col md:flex-row items-center justify-between gap-4">
            <a href="/" class="flex items-center space-x-3 group">
                <img src="/logo.png" alt="Logo" class="h-12 w-12 object-contain floating-logo">
                <div>
                    <span class="text-2xl font-extrabold tracking-wide drop-shadow-md">Free<span class="text-yellow-300">TransPNG</span></span>
                    <p class="text-xs text-gray-100">Magic Transparent Gallery</p>
                </div>
            </a>

            <!-- Search Form -->
            <form action="/" method="GET" class="w-full md:flex-1 max-w-md">
                <input type="text" name="search" value="<%= search %>" placeholder="Search HD transparent PNGs..." class="w-full px-4 py-2 rounded-full text-gray-800 focus:outline-none shadow-inner text-sm">
            </form>

            <nav class="flex flex-wrap items-center justify-center gap-4 text-sm font-semibold">
                <a href="/" class="hover:text-yellow-200 transition">Home</a>
                <a href="/about" class="hover:text-yellow-200 transition">About Us</a>
                <a href="/contact" class="hover:text-yellow-200 transition">Contact Us</a>
                <a href="/privacy" class="hover:text-yellow-200 transition">Privacy Policy</a>
            </nav>
        </div>

        <!-- Categories Bar -->
        <div class="bg-black/20 backdrop-blur-md py-2 px-4 border-t border-white/10">
            <div class="max-w-7xl mx-auto flex space-x-4 overflow-x-auto scrollbar-none text-sm items-center">
                <span class="text-yellow-300 font-bold whitespace-nowrap">🔥 Categories:</span>
                <a href="/" class="hover:bg-white/20 px-3 py-1 rounded-full transition whitespace-nowrap">All</a>
                <% categories.forEach(cat => { %>
                    <a href="/?category=<%= encodeURIComponent(cat.name) %>" class="hover:bg-white/20 px-3 py-1 rounded-full transition whitespace-nowrap <%= selectedCategory === cat.name ? 'bg-white/30 font-bold' : '' %>">
                        <%= cat.name %>
                    </a>
                <% }) %>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 py-8">
        <h2 class="text-2xl font-bold text-gray-800 mb-6 border-b pb-2">Explore HD Transparent PNGs</h2>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 md:gap-6">
            <% pngs.forEach(png => { %>
                <div class="png-card bg-white border border-gray-100 rounded-2xl p-4 flex flex-col justify-between shadow-sm relative group">
                    <a href="/png/<%= png._id %>" class="bg-gray-100 rounded-xl p-4 h-40 md:h-48 flex items-center justify-center overflow-hidden relative">
                        <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:12px_12px]"></div>
                        <img src="<%= png.imageUrl %>" alt="<%= png.title %>" class="max-h-full max-w-full object-contain relative z-10 group-hover:scale-105 transition duration-300">
                    </a>

                    <div class="mt-4">
                        <span class="text-xs text-indigo-600 font-semibold uppercase tracking-wider"><%= png.category %></span>
                        <h3 class="text-sm font-bold text-gray-800 truncate mt-1"><%= png.title %></h3>
                    </div>

                    <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between">
                        <span class="text-xs text-gray-400"><%= png.downloads %> Downloads</span>
                        <a href="/png/<%= png._id %>" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-3 py-2 rounded-lg shadow transition">
                            View & Download
                        </a>
                    </div>
                </div>
            <% }) %>
        </div>
    </main>

</body>
</html>