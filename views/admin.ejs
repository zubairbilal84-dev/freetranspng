<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - FreeTransPNG</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-100 font-sans">
    
    <header class="bg-gray-900 text-white p-4 flex justify-between items-center shadow">
        <h1 class="text-xl font-bold">FreeTransPNG Admin Panel</h1>
        <div class="space-x-3">
            <a href="/admin/categories" class="bg-purple-600 px-4 py-2 rounded text-sm hover:bg-purple-700 font-medium">Manage Categories 📁</a>
            <a href="/" target="_blank" class="bg-blue-600 px-4 py-2 rounded text-sm hover:bg-blue-700 font-medium">Visit Website ↗</a>
        </div>
    </header>

    <main class="container mx-auto p-6 space-y-6">
        
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-white p-5 rounded-xl shadow flex items-center justify-between">
                <div>
                    <p class="text-gray-500 text-sm">Total Uploaded PNGs</p>
                    <h3 class="text-2xl font-bold text-gray-800"><%= totalPngs %></h3>
                </div>
                <div class="bg-blue-100 p-3 rounded-lg text-blue-600 font-bold">📁</div>
            </div>
            <div class="bg-white p-5 rounded-xl shadow flex items-center justify-between">
                <div>
                    <p class="text-gray-500 text-sm">Total Downloads</p>
                    <h3 class="text-2xl font-bold text-gray-800"><%= sumDownloads %></h3>
                </div>
                <div class="bg-green-100 p-3 rounded-lg text-green-600 font-bold">📥</div>
            </div>
        </div>

        <!-- 📊 Traffic Analytics Section -->
        <div class="bg-white p-6 rounded-xl shadow">
            <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2"><span>📈</span> Website Traffic Overview (Click cards for details)</h2>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <a href="/admin/visitors/today" class="bg-indigo-50 border border-indigo-100 p-4 rounded-xl flex items-center justify-between hover:bg-indigo-100 transition cursor-pointer">
                    <div>
                        <p class="text-xs text-indigo-600 font-bold uppercase tracking-wider">Today's Visits</p>
                        <h3 class="text-2xl font-extrabold text-indigo-900 mt-1"><%= typeof dailyVisits !== 'undefined' ? dailyVisits : 0 %></h3>
                    </div>
                    <div class="bg-indigo-100 p-3 rounded-lg text-indigo-600 text-lg">📅</div>
                </a>
                <a href="/admin/visitors/weekly" class="bg-purple-50 border border-purple-100 p-4 rounded-xl flex items-center justify-between hover:bg-purple-100 transition cursor-pointer">
                    <div>
                        <p class="text-xs text-purple-600 font-bold uppercase tracking-wider">Weekly Visits</p>
                        <h3 class="text-2xl font-extrabold text-purple-900 mt-1"><%= typeof weeklyVisits !== 'undefined' ? weeklyVisits : 0 %></h3>
                    </div>
                    <div class="bg-purple-100 p-3 rounded-lg text-purple-600 text-lg">📊</div>
                </a>
                <a href="/admin/visitors/monthly" class="bg-emerald-50 border border-emerald-100 p-4 rounded-xl flex items-center justify-between hover:bg-emerald-100 transition cursor-pointer">
                    <div>
                        <p class="text-xs text-emerald-600 font-bold uppercase tracking-wider">Monthly Visits</p>
                        <h3 class="text-2xl font-extrabold text-emerald-900 mt-1"><%= typeof monthlyVisits !== 'undefined' ? monthlyVisits : 0 %></h3>
                    </div>
                    <div class="bg-emerald-100 p-3 rounded-lg text-emerald-600 text-lg">🌐</div>
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <!-- Left Column: Upload PNG Form with Multiple Categories & Smart Tags -->
            <div class="bg-white p-6 rounded-xl shadow h-fit">
                <h2 class="text-lg font-bold text-gray-800 mb-4">Upload New PNG</h2>
                <form action="/admin/upload" method="POST" enctype="multipart/form-data" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">PNG Title</label>
                        <input type="text" name="title" required placeholder="e.g. Diya PNG" class="w-full p-2.5 border rounded-lg text-sm outline-none">
                    </div>
                    
                    <!-- Multi-Category Select with Parent/Group Filtering & Recent Suggestions -->
                    <div class="relative">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Select Categories (Multiple)</label>
                        <input type="text" id="uploadCatInput" placeholder="Type parent/sub category..." autocomplete="off" class="w-full p-2.5 border rounded-lg text-sm outline-none bg-white" oninput="filterUploadCategories()" onclick="showUploadDropdown()">
                        <input type="hidden" name="category" id="uploadCatHidden" required>
                        
                        <!-- Selected Categories Container (Pills) -->
                        <div id="selectedCatContainer" class="flex flex-wrap gap-1 mt-2"></div>

                        <div id="uploadCatDropdown" class="hidden absolute z-10 w-full bg-white border border-gray-300 rounded-lg shadow-lg mt-1 max-h-48 overflow-y-auto p-1">
                            <!-- Recent 4 Categories Section -->
                            <div id="recentCategoriesSection" class="border-b pb-1 mb-1">
                                <div class="text-[10px] font-bold text-gray-400 px-2 uppercase">Recent Used:</div>
                                <div id="recentCatList" class="flex flex-wrap gap-1 p-1"></div>
                            </div>
                            <!-- All Categories List -->
                            <div id="allCatList">
                                <% categories.forEach(cat => { %>
                                    <div onclick="toggleUploadCategory('<%= cat.name %>')" class="p-2 hover:bg-blue-50 cursor-pointer text-sm text-gray-700 category-item rounded"><%= cat.name %></div>
                                <% }) %>
                            </div>
                        </div>
                    </div>

                    <!-- Comma Separated Smart Tags -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Tags (Paste with commas, press Enter)</label>
                        <input type="text" id="tagInput" placeholder="Type or paste tags with commas" class="w-full p-2.5 border rounded-lg text-sm outline-none mb-2">
                        <div id="tagContainer" class="flex flex-wrap gap-1 mb-1"></div>
                        <input type="hidden" name="tags" id="hiddenTags" required>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Select PNG File</label>
                        <input type="file" name="pngImage" accept="image/png" required class="w-full p-2 border rounded-lg bg-gray-50 text-sm">
                    </div>
                    <button type="submit" class="w-full bg-green-600 text-white py-2.5 rounded-lg font-bold hover:bg-green-700 transition text-sm">Upload PNG</button>
                </form>
            </div>

            <!-- Right Column: Manage Uploaded PNGs List Section (Latest 20 default) -->
            <div class="bg-white p-6 rounded-xl shadow md:col-span-2 flex flex-col">
                <div class="flex justify-between items-center mb-4 flex-wrap gap-3">
                    <h2 class="text-lg font-bold text-gray-800">Manage Uploaded PNGs <span class="text-xs text-gray-400 font-normal">(Showing latest or filtered)</span></h2>
                    
                    <form action="/admin" method="GET" class="flex gap-2 flex-wrap items-center">
                        <input type="text" name="search" value="<%= searchAdmin || '' %>" placeholder="Search title/tags..." class="p-2 border rounded-lg text-sm outline-none">
                        
                        <div class="relative">
                            <input type="text" id="filterCatInput" name="category" value="<%= typeof selectedCategory !== 'undefined' ? selectedCategory : '' %>" placeholder="Parent/Sub Category..." autocomplete="off" class="p-2 border rounded-lg text-sm outline-none bg-white">
                        </div>

                        <button type="submit" class="bg-gray-800 text-white px-4 py-2 rounded-lg text-sm font-semibold">Search</button>
                    </form>
                </div>

                <div class="overflow-x-auto flex-grow">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-200 text-gray-700 text-sm">
                                <th class="p-3">Preview</th>
                                <th class="p-3">Title & Tags</th>
                                <th class="p-3">Categories</th>
                                <th class="p-3">Downloads</th>
                                <th class="p-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 text-sm">
                            <% if(pngs.length > 0) { %>
                                <% pngs.forEach(png => { %>
                                    <tr class="hover:bg-gray-50">
                                        <td class="p-3">
                                            <img src="<%= png.imageUrl %>" class="h-10 w-10 object-contain bg-gray-100 rounded border p-1">
                                        </td>
                                        <td class="p-3 font-medium text-gray-800">
                                            <%= png.title %>
                                            <div class="text-xs text-blue-600 font-normal mt-0.5">Tags: <%= png.tags %></div>
                                        </td>
                                        <td class="p-3 text-gray-600"><%= png.category %></td>
                                        <td class="p-3 text-blue-600 font-semibold"><%= png.downloads %></td>
                                        <td class="p-3 space-x-2 flex items-center">
                                            <a href="/admin/edit/<%= png._id %>" class="text-blue-600 hover:underline font-medium text-xs bg-blue-50 px-2 py-1 rounded">Edit</a>
                                            <form action="/admin/delete/<%= png._id %>" method="POST" onsubmit="return confirm('Delete this PNG?');" class="inline">
                                                <button type="submit" class="text-red-600 hover:text-red-800 font-medium text-xs bg-red-50 px-2 py-1 rounded">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="p-4 text-center text-gray-500">No PNGs found.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </main>

    <script>
        // --- Multi-Category Selection & Recent Suggestions Logic ---
        let selectedCategoriesArray = [];
        let recentCategories = JSON.parse(localStorage.getItem('recentCats') || '[]');

        function showUploadDropdown() {
            document.getElementById('uploadCatDropdown').classList.remove('hidden');
            renderRecentCategories();
        }

        function renderRecentCategories() {
            let container = document.getElementById('recentCatList');
            container.innerHTML = '';
            if(recentCategories.length === 0) {
                document.getElementById('recentCategoriesSection').style.display = 'none';
                return;
            }
            document.getElementById('recentCategoriesSection').style.display = 'block';
            recentCategories.forEach(cat => {
                let span = document.createElement('span');
                span.className = "bg-purple-100 text-purple-700 text-xs px-2 py-0.5 rounded cursor-pointer font-medium hover:bg-purple-200";
                span.textContent = cat;
                span.onclick = () => toggleUploadCategory(cat);
                container.appendChild(span);
            });
        }

        function filterUploadCategories() {
            let input = document.getElementById('uploadCatInput').value.toLowerCase();
            let items = document.querySelectorAll('.category-item');
            document.getElementById('uploadCatDropdown').classList.remove('hidden');
            
            items.forEach(item => {
                let text = item.textContent.toLowerCase();
                if (text.includes(input)) {
                    item.style.display = "block";
                } else {
                    item.style.display = "none";
                }
            });
        }

        function toggleUploadCategory(name) {
            if (!selectedCategoriesArray.includes(name)) {
                selectedCategoriesArray.push(name);
                // Update recent list
                recentCategories = [name, ...recentCategories.filter(c => c !== name)].slice(0, 4);
                localStorage.setItem('recentCats', JSON.stringify(recentCategories));
            } else {
                selectedCategoriesArray = selectedCategoriesArray.filter(c => c !== name);
            }
            renderSelectedCategories();
            document.getElementById('uploadCatInput').value = '';
        }

        function renderSelectedCategories() {
            let container = document.getElementById('selectedCatContainer');
            container.innerHTML = '';
            selectedCategoriesArray.forEach((cat, index) => {
                let span = document.createElement('span');
                span.className = "bg-blue-100 text-blue-700 text-xs px-2 py-1 rounded flex items-center gap-1 font-medium";
                span.innerHTML = `${cat} <button type="button" onclick="removeSelectedCategory(${index})" class="text-red-500 font-bold ml-1">×</button>`;
                container.appendChild(span);
            });
            document.getElementById('uploadCatHidden').value = selectedCategoriesArray.join(', ');
        }

        function removeSelectedCategory(index) {
            selectedCategoriesArray.splice(index, 1);
            renderSelectedCategories();
        }

        window.addEventListener('click', function(e) {
            if (!document.getElementById('uploadCatInput').contains(e.target) && !document.getElementById('uploadCatDropdown').contains(e.target)) {
                document.getElementById('uploadCatDropdown').classList.add('hidden');
            }
        });

        // --- Smart Comma-Separated Tag System ---
        const tagInput = document.getElementById('tagInput');
        const tagContainer = document.getElementById('tagContainer');
        const hiddenTags = document.getElementById('hiddenTags');
        let tagsArray = [];

        tagInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ',') {
                e.preventDefault();
                processTagsInput(tagInput.value);
                tagInput.value = '';
            }
        });

        tagInput.addEventListener('paste', function(e) {
            e.preventDefault();
            let pasteData = (e.clipboardData || window.clipboardData).getData('text');
            processTagsInput(pasteData);
            tagInput.value = '';
        });

        function processTagsInput(str) {
            let parts = str.split(',');
            parts.forEach(part => {
                let val = part.trim().replace(/^#+/, '');
                if (val && !tagsArray.includes(val)) {
                    tagsArray.push(val);
                }
            });
            renderTags();
        }

        function renderTags() {
            tagContainer.innerHTML = '';
            tagsArray.forEach((tag, index) => {
                let span = document.createElement('span');
                span.className = "bg-green-100 text-green-700 text-xs px-2 py-1 rounded flex items-center gap-1 font-medium";
                span.innerHTML = `${tag} <button type="button" onclick="removeTag(${index})" class="text-red-500 font-bold ml-1">×</button>`;
                tagContainer.appendChild(span);
            });
            hiddenTags.value = tagsArray.join(', ');
        }

        function removeTag(index) {
            tagsArray.splice(index, 1);
            renderTags();
        }
    </script>
</body>
</html>