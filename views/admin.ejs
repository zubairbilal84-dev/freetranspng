<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - FreeTransPNG</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-100 font-sans">
    
    <header class="bg-gray-900 text-white p-4 flex flex-col sm:flex-row justify-between items-center gap-3 shadow">
        <h1 class="text-xl font-bold text-center sm:text-left">FreeTransPNG Admin Panel</h1>
        <div class="flex flex-wrap justify-center gap-2">
            <a href="/admin/categories" class="bg-purple-600 px-3 py-1.5 rounded text-xs sm:text-sm hover:bg-purple-700 font-medium">Manage Categories 📁</a>
            <a href="/" target="_blank" class="bg-blue-600 px-3 py-1.5 rounded text-xs sm:text-sm hover:bg-blue-700 font-medium">Visit Website ↗</a>
        </div>
    </header>

    <main class="container mx-auto p-6 space-y-6">
        
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-white p-5 rounded-xl shadow flex items-center justify-between">
                <div>
                    <p class="text-gray-500 text-sm">Total Uploaded PNGs</p>
                    <h3 class="text-2xl font-bold text-gray-800"><%= totalPngs %></h3>
                </div>
                <div class="bg-blue-100 p-3 rounded-lg text-blue-600 font-bold">📁</div>
            </div>
            <div class="bg-white p-5 rounded-xl shadow flex items-center justify-between">
                <div>
                    <p class="text-gray-500 text-sm">Total Downloads (All-Time)</p>
                    <h3 class="text-2xl font-bold text-gray-800"><%= sumDownloads %></h3>
                </div>
                <div class="bg-green-100 p-3 rounded-lg text-green-600 font-bold">📥</div>
            </div>
        </div>

        <!-- Download Analytics Section -->
        <div class="bg-white p-6 rounded-xl shadow">
            <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2"><span>📊</span> Download Performance Analytics</h2>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="bg-green-50 border border-green-100 p-4 rounded-xl flex items-center justify-between">
                    <div>
                        <p class="text-xs text-green-600 font-bold uppercase tracking-wider">Today's Downloads</p>
                        <h3 class="text-2xl font-extrabold text-green-900 mt-1"><%= typeof dailyDownloads !== 'undefined' ? dailyDownloads : 0 %></h3>
                    </div>
                    <div class="bg-green-100 p-3 rounded-lg text-green-600 text-lg">📈</div>
                </div>
                <div class="bg-teal-50 border border-teal-100 p-4 rounded-xl flex items-center justify-between">
                    <div>
                        <p class="text-xs text-teal-600 font-bold uppercase tracking-wider">Weekly Downloads</p>
                        <h3 class="text-2xl font-extrabold text-teal-900 mt-1"><%= typeof weeklyDownloads !== 'undefined' ? weeklyDownloads : 0 %></h3>
                    </div>
                    <div class="bg-teal-100 p-3 rounded-lg text-teal-600 text-lg">📉</div>
                </div>
                <div class="bg-cyan-50 border border-cyan-100 p-4 rounded-xl flex items-center justify-between">
                    <div>
                        <p class="text-xs text-cyan-600 font-bold uppercase tracking-wider">Monthly Downloads</p>
                        <h3 class="text-2xl font-extrabold text-cyan-900 mt-1"><%= typeof monthlyDownloads !== 'undefined' ? monthlyDownloads : 0 %></h3>
                    </div>
                    <div class="bg-cyan-100 p-3 rounded-lg text-cyan-600 text-lg">📊</div>
                </div>
            </div>
        </div>

        <!-- 📊 Traffic & Region/Country Analytics Section Restored -->
        <div class="bg-white p-6 rounded-xl shadow">
            <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2"><span>📈</span> Website Traffic & Region Overview (Click cards to view visitor logs)</h2>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <a href="/admin/visitors/today" class="bg-indigo-50 border border-indigo-100 p-4 rounded-xl flex items-center justify-between hover:bg-indigo-100 transition cursor-pointer">
                    <div>
                        <p class="text-xs text-indigo-600 font-bold uppercase tracking-wider">Today's Visits</p>
                        <h3 class="text-2xl font-extrabold text-indigo-900 mt-1"><%= typeof dailyVisits !== 'undefined' ? dailyVisits : 0 %></h3>
                    </div>
                    <div class="bg-indigo-100 p-3 rounded-lg text-indigo-600 text-lg">📅</div>
                </a>
                <a href="/admin/visitors/weekly" class="bg-purple-50 border border-purple-100 p-4 rounded-xl flex items-center justify-between hover:bg-purple-100 transition cursor-pointer">
                    <div>
                        <p class="text-xs text-purple-600 font-bold uppercase tracking-wider">Weekly Visits</p>
                        <h3 class="text-2xl font-extrabold text-purple-900 mt-1"><%= typeof weeklyVisits !== 'undefined' ? weeklyVisits : 0 %></h3>
                    </div>
                    <div class="bg-purple-100 p-3 rounded-lg text-purple-600 text-lg">📊</div>
                </a>
                <a href="/admin/visitors/monthly" class="bg-emerald-50 border border-emerald-100 p-4 rounded-xl flex items-center justify-between hover:bg-emerald-100 transition cursor-pointer">
                    <div>
                        <p class="text-xs text-emerald-600 font-bold uppercase tracking-wider">Monthly Visits</p>
                        <h3 class="text-2xl font-extrabold text-emerald-900 mt-1"><%= typeof monthlyVisits !== 'undefined' ? monthlyVisits : 0 %></h3>
                    </div>
                    <div class="bg-emerald-100 p-3 rounded-lg text-emerald-600 text-lg">🌐</div>
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <!-- Left Column: All Upload Forms -->
            <div class="space-y-6">
                
                <!-- 1. Single Upload PNG Form -->
                <div class="bg-white p-6 rounded-xl shadow h-fit">
                    <h2 class="text-lg font-bold text-gray-800 mb-4">Upload Single PNG</h2>
                    <form action="/admin/upload" method="POST" enctype="multipart/form-data" class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">PNG Title</label>
                            <input type="text" name="title" required placeholder="e.g. Diya PNG" class="w-full p-2.5 border rounded-lg text-sm outline-none">
                        </div>
                        
                        <div class="relative">
                            <label class="block text-sm font-medium text-gray-700 mb-1">Select Categories (Multiple)</label>
                            <input type="text" id="uploadCatInput" placeholder="Type letters or click parent..." autocomplete="off" class="w-full p-2.5 border rounded-lg text-sm outline-none bg-white" oninput="filterUploadCategories()" onclick="showUploadDropdown()">
                            <input type="hidden" name="category" id="uploadCatHidden" required>
                            
                            <div id="selectedCatContainer" class="flex flex-wrap gap-1 mt-2"></div>

                            <div id="uploadCatDropdown" class="hidden absolute z-10 w-full bg-white border border-gray-300 rounded-lg shadow-lg mt-1 max-h-56 overflow-y-auto p-1">
                                <div id="recentCategoriesSection" class="border-b pb-1 mb-1">
                                    <div class="text-[10px] font-bold text-gray-400 px-2 uppercase">Recent Used:</div>
                                    <div id="recentCatList" class="flex flex-wrap gap-1 p-1"></div>
                                </div>
                                <div id="allCatList" class="space-y-1">
                                    <% 
                                       let parentMap = {};
                                       let standAlones = [];
                                       categories.forEach(cat => {
                                           if(cat.parentCategory) {
                                               if(!parentMap[cat.parentCategory]) parentMap[cat.parentCategory] = [];
                                               parentMap[cat.parentCategory].push(cat.name);
                                           } else {
                                               standAlones.push(cat.name);
                                           }
                                       });
                                    %>
                                    <div class="text-[10px] font-bold text-indigo-600 px-2 uppercase bg-indigo-50 py-0.5">Parent Categories</div>
                                    <% Object.keys(parentMap).forEach(parent => { %>
                                        <div onclick="selectParentForSearch('<%= parent %>')" class="p-2 hover:bg-indigo-100 cursor-pointer text-xs font-bold text-indigo-900 rounded parent-item flex justify-between items-center">
                                            📁 <%= parent %> <span class="text-[10px] text-gray-500 font-normal">View sub-cats ›</span>
                                        </div>
                                        <% parentMap[parent].forEach(sub => { %>
                                            <div onclick="toggleUploadCategory('<%= sub %>')" data-parent="<%= parent %>" class="p-1.5 pl-6 hover:bg-blue-50 cursor-pointer text-sm text-gray-700 sub-cat-item rounded hidden">
                                                ↳ <%= sub %>
                                            </div>
                                        <% }) %>
                                    <% }) %>
                                    <% if(standAlones.length > 0) { %>
                                        <div class="text-[10px] font-bold text-gray-400 px-2 uppercase mt-2 bg-gray-50 py-0.5">Other Categories</div>
                                        <% standAlones.forEach(cat => { %>
                                            <div onclick="toggleUploadCategory('<%= cat %>')" class="p-2 hover:bg-blue-50 cursor-pointer text-sm text-gray-700 category-item rounded"><%= cat %></div>
                                        <% }) %>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Tags (Comma separated, press Enter)</label>
                            <input type="text" id="tagInput" placeholder="Type or paste tags with commas" class="w-full p-2.5 border rounded-lg text-sm outline-none mb-2">
                            <div id="tagContainer" class="flex flex-wrap gap-1 mb-1"></div>
                            <input type="hidden" name="tags" id="hiddenTags" required>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Select PNG File</label>
                            <input type="file" name="pngImage" accept="image/png" required class="w-full p-2 border rounded-lg bg-gray-50 text-sm">
                        </div>
                        <button type="submit" class="w-full bg-green-600 text-white py-2.5 rounded-lg font-bold hover:bg-green-700 transition text-sm">Upload PNG</button>
                    </form>
                </div>

                <!-- 2. Common Batch Bulk Upload Section -->
                <div class="bg-white p-6 rounded-xl shadow h-fit border-2 border-purple-300">
                    <h2 class="text-lg font-bold text-gray-800 mb-1">⚡ Common Batch Bulk Upload</h2>
                    <p class="text-xs text-gray-500 mb-4">Titles ki list paste karein, common category aur tags select karein, aur bohot saari PNGs ek sath select karke upload karein.</p>
                    
                    <form action="/admin/bulk-upload" method="POST" enctype="multipart/form-data" class="space-y-4">
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Titles List (Comma/Newline/Period separated)</label>
                            <textarea name="bulkTitles" rows="3" required placeholder="Title 1. Title 2, Title 3..." class="w-full p-2.5 border rounded-lg text-xs bg-white outline-none"></textarea>
                        </div>

                        <div class="relative">
                            <label class="block text-xs font-medium text-gray-700 mb-1">Common Category</label>
                            <input type="text" id="batchCatInput" placeholder="Type letters or click parent..." autocomplete="off" class="w-full p-2.5 border rounded-lg text-xs outline-none bg-white" oninput="filterBatchCategories()" onclick="showBatchDropdown()">
                            <input type="hidden" name="commonCategory" id="batchCatHidden" required>
                            <div id="batchSelectedCatContainer" class="flex flex-wrap gap-1 mt-1.5"></div>
                            <div id="batchCatDropdown" class="hidden absolute z-20 w-full bg-white border border-gray-300 rounded-lg shadow-lg mt-1 max-h-48 overflow-y-auto p-1 text-xs">
                                <div id="batchCatListContent">
                                    <% Object.keys(parentMap).forEach(parent => { %>
                                        <div onclick="selectBatchParentForSearch('<%= parent %>')" class="p-1.5 hover:bg-indigo-100 cursor-pointer font-bold text-indigo-900 rounded batch-parent-item flex justify-between items-center">📁 <%= parent %> <span class="text-[9px] text-gray-500">View sub-cats ›</span></div>
                                        <% parentMap[parent].forEach(sub => { %>
                                            <div onclick="toggleBatchCategory('<%= sub %>')" data-parent="<%= parent %>" class="p-1 pl-5 hover:bg-blue-50 cursor-pointer text-gray-700 rounded batch-subcat-item hidden">↳ <%= sub %></div>
                                        <% }) %>
                                    <% }) %>
                                    <% if(standAlones.length > 0) { %>
                                        <% standAlones.forEach(cat => { %>
                                            <div onclick="toggleBatchCategory('<%= cat %>')" class="p-1.5 hover:bg-blue-50 cursor-pointer text-gray-700 rounded batch-category-item"><%= cat %></div>
                                        <% }) %>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Common Tags (Comma separated)</label>
                            <input type="text" id="batchTagInput" placeholder="tag1, tag2, tag3" class="w-full p-2.5 border rounded-lg text-xs outline-none mb-1" onkeydown="handleBatchTagKey(event)" onpaste="handleBatchTagPaste(event)">
                            <div id="batchTagContainer" class="flex flex-wrap gap-1 mb-1"></div>
                            <input type="hidden" name="commonTags" id="batchHiddenTags" required>
                        </div>

                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Select Multiple PNG Files</label>
                            <input type="file" name="pngImages" accept="image/png" multiple required class="w-full p-2 border rounded-lg bg-gray-50 text-xs">
                        </div>

                        <button type="submit" class="w-full bg-purple-600 text-white py-2.5 rounded-lg font-bold hover:bg-purple-700 transition text-sm">
                            🚀 Upload Batch PNGs
                        </button>
                    </form>
                </div>

                <!-- 3. Multi-PNG Custom Builder Section -->
                <div class="bg-white p-6 rounded-xl shadow h-fit border-2 border-indigo-200">
                    <h2 class="text-lg font-bold text-gray-800 mb-1">⚡ Multi-PNG Custom Builder</h2>
                    <p class="text-xs text-gray-500 mb-4">Har row me alag title, parent/sub category, aur tags set karke multiple rows add karein.</p>
                    
                    <form action="/admin/bulk-upload" method="POST" enctype="multipart/form-data" class="space-y-4">
                        <div id="dynamicRowsContainer" class="space-y-4"></div>

                        <button type="button" onclick="addDynamicRow()" class="w-full bg-indigo-50 border border-indigo-200 text-indigo-700 py-2 rounded-lg font-bold hover:bg-indigo-100 transition text-xs">
                            + Add Another Custom PNG Row
                        </button>

                        <button type="submit" class="w-full bg-indigo-600 text-white py-2.5 rounded-lg font-bold hover:bg-indigo-700 transition text-sm">
                            🚀 Upload Custom Multi-Row PNGs
                        </button>
                    </form>
                </div>

            </div>

            <!-- Right Column: Manage Uploaded PNGs with Pagination -->
            <div class="bg-white p-6 rounded-xl shadow md:col-span-2 flex flex-col justify-between">
               <div>
                    <div class="flex justify-between items-center mb-4 flex-wrap gap-3">
                        <h2 class="text-lg font-bold text-gray-800">Manage Uploaded PNGs <span class="text-xs text-gray-400 font-normal">(20 per page)</span></h2>
                        
                        <form action="/admin" method="GET" class="flex gap-2 flex-wrap items-center">
                            <input type="text" name="search" value="<%= searchAdmin || '' %>" placeholder="Search title/tags..." class="p-2 border rounded-lg text-sm outline-none">
                            <input type="text" name="category" value="<%= typeof selectedCategory !== 'undefined' ? selectedCategory : '' %>" placeholder="Category filter..." class="p-2 border rounded-lg text-sm outline-none bg-white">
                            <button type="submit" class="bg-gray-800 text-white px-4 py-2 rounded-lg text-sm font-semibold">Search</button>
                        </form>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-gray-200 text-gray-700 text-sm">
                                    <th class="p-3">Preview</th>
                                    <th class="p-3">Title & Tags</th>
                                    <th class="p-3">Categories</th>
                                    <th class="p-3">Downloads</th>
                                    <th class="p-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200 text-sm">
                                <% if(pngs.length > 0) { %>
                                    <% pngs.forEach(png => { %>
                                        <tr class="hover:bg-gray-50">
                                            <td class="p-3">
                                                <img src="<%= png.imageUrl %>" class="h-10 w-10 object-contain bg-gray-100 rounded border p-1">
                                            </td>
                                            <td class="p-3 font-medium text-gray-800">
                                                <%= png.title %>
                                                <div class="text-xs text-blue-600 font-normal mt-0.5">Tags: <%= png.tags %></div>
                                            </td>
                                            <td class="p-3 text-gray-600"><%= png.category %></td>
                                            <td class="p-3 text-blue-600 font-semibold"><%= png.downloads %></td>
                                            <td class="p-3 space-x-2 flex items-center">
                                                <a href="/admin/edit/<%= png._id %>" class="text-blue-600 hover:underline font-medium text-xs bg-blue-50 px-2 py-1 rounded">Edit</a>
                                                <form action="/admin/delete/<%= png._id %>" method="POST" onsubmit="return confirm('Delete this PNG?');" class="inline">
                                                    <button type="submit" class="text-red-600 hover:text-red-800 font-medium text-xs bg-red-50 px-2 py-1 rounded">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="p-4 text-center text-gray-500">No PNGs found.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
               </div>

               <!-- Pagination Controls -->
               <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                    <div class="flex justify-between items-center mt-6 pt-4 border-t text-sm">
                        <span class="text-gray-500">Page <%= currentPage %> of <%= totalPages %></span>
                        <div class="flex gap-1">
                            <% if (currentPage > 1) { %>
                                <a href="/admin?page=<%= currentPage - 1 %>&search=<%= searchAdmin || '' %>&category=<%= selectedCategory || '' %>" class="px-3 py-1.5 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 font-bold">← Prev</a>
                            <% } %>
                            <% if (currentPage < totalPages) { %>
                                <a href="/admin?page=<%= currentPage + 1 %>&search=<%= searchAdmin || '' %>&category=<%= selectedCategory || '' %>" class="px-3 py-1.5 bg-indigo-600 text-white rounded hover:bg-indigo-700 font-bold">Next →</a>
                            <% } %>
                        </div>
                    </div>
               <% } %>
            </div>

        </div>
    </main>

    <script>
        // --- Single Upload Logic ---
        let selectedCategoriesArray = [];
        let recentCategories = JSON.parse(localStorage.getItem('recentCats') || '[]');

        function showUploadDropdown() {
            document.getElementById('uploadCatDropdown').classList.remove('hidden');
            renderRecentCategories();
        }

        function renderRecentCategories() {
            let container = document.getElementById('recentCatList');
            container.innerHTML = '';
            if(recentCategories.length === 0) {
                document.getElementById('recentCategoriesSection').style.display = 'none';
                return;
            }
            document.getElementById('recentCategoriesSection').style.display = 'block';
            recentCategories.forEach(cat => {
                let span = document.createElement('span');
                span.className = "bg-purple-100 text-purple-700 text-xs px-2 py-0.5 rounded cursor-pointer font-medium hover:bg-purple-200";
                span.textContent = cat;
                span.onclick = () => toggleUploadCategory(cat);
                container.appendChild(span);
            });
        }

        function selectParentForSearch(parentName) {
            let searchInput = document.getElementById('uploadCatInput');
            searchInput.value = parentName;
            let subItems = document.querySelectorAll('.sub-cat-item');
            subItems.forEach(item => {
                item.style.display = (item.getAttribute('data-parent').toLowerCase() === parentName.toLowerCase()) ? 'block' : 'none';
            });
            document.getElementById('uploadCatDropdown').classList.remove('hidden');
        }

        function filterUploadCategories() {
            let input = document.getElementById('uploadCatInput').value.toLowerCase();
            document.getElementById('uploadCatDropdown').classList.remove('hidden');
            document.querySelectorAll('.parent-item').forEach(i => i.style.display = i.textContent.toLowerCase().includes(input) ? "flex" : "none");
            document.querySelectorAll('.sub-cat-item').forEach(i => i.style.display = i.textContent.toLowerCase().includes(input) ? "block" : "none");
            document.querySelectorAll('.category-item').forEach(i => i.style.display = i.textContent.toLowerCase().includes(input) ? "block" : "none");
        }

        function toggleUploadCategory(name) {
            if (!selectedCategoriesArray.includes(name)) {
                selectedCategoriesArray.push(name);
                recentCategories = [name, ...recentCategories.filter(c => c !== name)].slice(0, 4);
                localStorage.setItem('recentCats', JSON.stringify(recentCategories));
            } else {
                selectedCategoriesArray = selectedCategoriesArray.filter(c => c !== name);
            }
            renderSelectedCategories();
            document.getElementById('uploadCatInput').value = '';
        }

        function renderSelectedCategories() {
            let container = document.getElementById('selectedCatContainer');
            container.innerHTML = '';
            selectedCategoriesArray.forEach((cat, index) => {
                let span = document.createElement('span');
                span.className = "bg-blue-100 text-blue-700 text-xs px-2 py-1 rounded flex items-center gap-1 font-medium";
                span.innerHTML = `${cat} <button type="button" onclick="removeSelectedCategory(${index})" class="text-red-500 font-bold ml-1">×</button>`;
                container.appendChild(span);
            });
            document.getElementById('uploadCatHidden').value = selectedCategoriesArray.join(', ');
        }

        function removeSelectedCategory(index) {
            selectedCategoriesArray.splice(index, 1);
            renderSelectedCategories();
        }

        const tagInput = document.getElementById('tagInput');
        const tagContainer = document.getElementById('tagContainer');
        const hiddenTags = document.getElementById('hiddenTags');
        let tagsArray = [];

        tagInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ',') {
                e.preventDefault();
                processTagsInput(tagInput.value);
                tagInput.value = '';
            }
        });
        tagInput.addEventListener('paste', function(e) {
            e.preventDefault();
            processTagsInput((e.clipboardData || window.clipboardData).getData('text'));
            tagInput.value = '';
        });

        function processTagsInput(str) {
            str.split(',').forEach(part => {
                let val = part.trim().replace(/^#+/, '');
                if (val && !tagsArray.includes(val)) tagsArray.push(val);
            });
            renderTags();
        }

        function renderTags() {
            tagContainer.innerHTML = '';
            tagsArray.forEach((tag, index) => {
                let span = document.createElement('span');
                span.className = "bg-green-100 text-green-700 text-xs px-2 py-1 rounded flex items-center gap-1 font-medium";
                span.innerHTML = `${tag} <button type="button" onclick="removeTag(${index})" class="text-red-500 font-bold ml-1">×</button>`;
                tagContainer.appendChild(span);
            });
            hiddenTags.value = tagsArray.join(', ');
        }

        function removeTag(index) {
            tagsArray.splice(index, 1);
            renderTags();
        }

        // --- Common Batch Bulk Upload JS Logic ---
        let batchCategoriesArray = [];
        function showBatchDropdown() { document.getElementById('batchCatDropdown').classList.remove('hidden'); }
        function selectBatchParentForSearch(parentName) {
            document.getElementById('batchCatInput').value = parentName;
            document.querySelectorAll('.batch-subcat-item').forEach(item => {
                item.style.display = (item.getAttribute('data-parent').toLowerCase() === parentName.toLowerCase()) ? 'block' : 'none';
            });
            document.getElementById('batchCatDropdown').classList.remove('hidden');
        }
        function filterBatchCategories() {
            let input = document.getElementById('batchCatInput').value.toLowerCase();
            document.getElementById('batchCatDropdown').classList.remove('hidden');
            document.querySelectorAll('.batch-parent-item').forEach(i => i.style.display = i.textContent.toLowerCase().includes(input) ? "flex" : "none");
            document.querySelectorAll('.batch-subcat-item').forEach(i => i.style.display = i.textContent.toLowerCase().includes(input) ? "block" : "none");
            document.querySelectorAll('.batch-category-item').forEach(i => i.style.display = i.textContent.toLowerCase().includes(input) ? "block" : "none");
        }
        function toggleBatchCategory(name) {
            if (!batchCategoriesArray.includes(name)) batchCategoriesArray.push(name);
            else batchCategoriesArray = batchCategoriesArray.filter(c => c !== name);
            renderBatchCategories();
            document.getElementById('batchCatInput').value = '';
        }
        function renderBatchCategories() {
            let container = document.getElementById('batchSelectedCatContainer');
            container.innerHTML = '';
            batchCategoriesArray.forEach((cat, index) => {
                let span = document.createElement('span');
                span.className = "bg-blue-100 text-blue-700 text-xs px-2 py-1 rounded flex items-center gap-1 font-medium";
                span.innerHTML = `${cat} <button type="button" onclick="removeBatchCategory(${index})" class="text-red-500 font-bold ml-1">×</button>`;
                container.appendChild(span);
            });
            document.getElementById('batchCatHidden').value = batchCategoriesArray.join(', ');
        }
        function removeBatchCategory(index) { batchCategoriesArray.splice(index, 1); renderBatchCategories(); }

        const batchTagInput = document.getElementById('batchTagInput');
        const batchTagContainer = document.getElementById('batchTagContainer');
        const batchHiddenTags = document.getElementById('batchHiddenTags');
        let batchTagsArray = [];

        batchTagInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ',') {
                e.preventDefault();
                processBatchTags(batchTagInput.value);
                batchTagInput.value = '';
            }
        });
        batchTagInput.addEventListener('paste', function(e) {
            e.preventDefault();
            processBatchTags((e.clipboardData || window.clipboardData).getData('text'));
            batchTagInput.value = '';
        });

        function processBatchTags(str) {
            str.split(',').forEach(part => {
                let val = part.trim().replace(/^#+/, '');
                if (val && !batchTagsArray.includes(val)) batchTagsArray.push(val);
            });
            renderBatchTags();
        }
        function renderBatchTags() {
            batchTagContainer.innerHTML = '';
            batchTagsArray.forEach((tag, index) => {
                let span = document.createElement('span');
                span.className = "bg-green-100 text-green-700 text-xs px-2 py-1 rounded flex items-center gap-1 font-medium";
                span.innerHTML = `${tag} <button type="button" onclick="removeBatchTag(${index})" class="text-red-500 font-bold ml-1">×</button>`;
                batchTagContainer.appendChild(span);
            });
            batchHiddenTags.value = batchTagsArray.join(', ');
        }
        function removeBatchTag(index) { batchTagsArray.splice(index, 1); renderBatchTags(); }

        // --- Multi-PNG Custom Builder Logic ---
        let rowIndex = 0;
        const allCategoriesList = JSON.parse('<%- JSON.stringify(categories) %>');

        function addDynamicRow() {
            let container = document.getElementById('dynamicRowsContainer');
            let rowId = rowIndex++;
            
            let rowDiv = document.createElement('div');
            rowDiv.className = "p-4 bg-gray-50 border border-gray-200 rounded-xl space-y-3 relative row-item";
            rowDiv.setAttribute('data-row-id', rowId);
            
            rowDiv.innerHTML = `
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold text-indigo-700">Custom PNG Entry #${rowId + 1}</span>
                    <button type="button" onclick="this.closest('div.row-item').remove()" class="text-red-500 text-xs font-bold hover:underline">Remove ✕</button>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Title</label>
                    <input type="text" name="titles" required placeholder="PNG Title" class="w-full p-2 border rounded text-xs bg-white outline-none">
                </div>
                <div class="relative">
                    <label class="block text-xs font-medium text-gray-700 mb-1">Categories</label>
                    <input type="text" id="rowCatInput_${rowId}" placeholder="Type letters or click parent..." autocomplete="off" class="w-full p-2 border rounded text-xs bg-white outline-none" oninput="filterRowCategories(${rowId})" onclick="showRowDropdown(${rowId})">
                    <input type="hidden" name="categories" id="rowCatHidden_${rowId}" required>
                    <div id="rowSelectedCatContainer_${rowId}" class="flex flex-wrap gap-1 mt-1"></div>
                    <div id="rowCatDropdown_${rowId}" class="hidden absolute z-20 w-full bg-white border border-gray-300 rounded-lg shadow-lg mt-1 max-h-40 overflow-y-auto p-1 text-xs">
                        <div id="rowCatList_${rowId}">${generateRowCategoriesHtml(rowId)}</div>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Tags (Comma/Enter)</label>
                    <input type="text" id="rowTagInput_${rowId}" placeholder="tag1, tag2..." class="w-full p-2 border rounded text-xs bg-white outline-none mb-1" onkeydown="handleRowTagKey(event, ${rowId})" onpaste="handleRowTagPaste(event, ${rowId})">
                    <div id="rowTagContainer_${rowId}" class="flex flex-wrap gap-1 mb-1"></div>
                    <input type="hidden" name="tags" id="rowHiddenTags_${rowId}" required>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">PNG File</label>
                    <input type="file" name="pngImages${rowId}" accept="image/png" required class="w-full p-1 border rounded bg-white text-xs">
                </div>
            `;
            container.appendChild(rowDiv);
            window[`rowCats_${rowId}`] = [];
            window[`rowTags_${rowId}`] = [];
        }

        function generateRowCategoriesHtml(rowId) {
            let parentMap = {};
            let standAlones = [];
            allCategoriesList.forEach(cat => {
                if(cat.parentCategory) {
                    if(!parentMap[cat.parentCategory]) parentMap[cat.parentCategory] = [];
                    parentMap[cat.parentCategory].push(cat.name);
                } else {
                    standAlones.push(cat.name);
                }
            });
            let html = '';
            Object.keys(parentMap).forEach(parent => {
                html += `<div onclick="selectRowParentForSearch(${rowId}, '${parent.replace(/'/g, "\\'")}')" class="p-1 hover:bg-indigo-100 cursor-pointer font-bold text-indigo-900 rounded row-parent-${rowId} flex justify-between items-center">📁 ${parent} <span class="text-[8px]">›</span></div>`;
                parentMap[parent].forEach(sub => {
                    html += `<div onclick="toggleRowCategory(${rowId}, '${sub.replace(/'/g, "\\'")}')" data-parent="${parent}" class="p-1 pl-4 hover:bg-blue-50 cursor-pointer text-gray-700 rounded row-subcat-${rowId} hidden">↳ ${sub}</div>`;
                });
            });
            if(standAlones.length > 0) {
                standAlones.forEach(cat => {
                    html += `<div onclick="toggleRowCategory(${rowId}, '${cat.replace(/'/g, "\\'")}')" class="p-1 hover:bg-blue-50 cursor-pointer text-gray-700 rounded row-cat-${rowId}">${cat}</div>`;
                });
            }
            return html;
        }

        function showRowDropdown(rowId) { document.getElementById(`rowCatDropdown_${rowId}`).classList.remove('hidden'); }
        function selectRowParentForSearch(rowId, parentName) {
            document.getElementById(`rowCatInput_${rowId}`).value = parentName;
            document.querySelectorAll(`.row-subcat-${rowId}`).forEach(item => {
                item.style.display = (item.getAttribute('data-parent').toLowerCase() === parentName.toLowerCase()) ? 'block' : 'none';
            });
            document.getElementById(`rowCatDropdown_${rowId}`).classList.remove('hidden');
        }
        function filterRowCategories(rowId) {
            let input = document.getElementById(`rowCatInput_${rowId}`).value.toLowerCase();
            document.getElementById(`rowCatDropdown_${rowId}`).classList.remove('hidden');
            document.querySelectorAll(`.row-parent-${rowId}`).forEach(i => i.style.display = i.textContent.toLowerCase().includes(input) ? "flex" : "none");
            document.querySelectorAll(`.row-subcat-${rowId}`).forEach(i => i.style.display = i.textContent.toLowerCase().includes(input) ? "block" : "none");
            document.querySelectorAll(`.row-cat-${rowId}`).forEach(i => i.style.display = i.textContent.toLowerCase().includes(input) ? "block" : "none");
        }
        function toggleRowCategory(rowId, name) {
            let arr = window[`rowCats_${rowId}`];
            if (!arr.includes(name)) arr.push(name);
            else window[`rowCats_${rowId}`] = arr.filter(c => c !== name);
            renderRowCategories(rowId);
            document.getElementById(`rowCatInput_${rowId}`).value = '';
        }
        function renderRowCategories(rowId) {
            let container = document.getElementById(`rowSelectedCatContainer_${rowId}`);
            let arr = window[`rowCats_${rowId}`];
            container.innerHTML = '';
            arr.forEach((cat, idx) => {
                let span = document.createElement('span');
                span.className = "bg-blue-100 text-blue-700 text-[9px] px-1.5 py-0.5 rounded flex items-center gap-1 font-medium";
                span.innerHTML = `${cat} <button type="button" onclick="removeRowCategory(${rowId}, ${idx})" class="text-red-500 font-bold ml-1">×</button>`;
                container.appendChild(span);
            });
            document.getElementById(`rowCatHidden_${rowId}`).value = arr.join(', ');
        }
        function removeRowCategory(rowId, idx) { window[`rowCats_${rowId}`].splice(idx, 1); renderRowCategories(rowId); }

        function handleRowTagKey(e, rowId) {
            if (e.key === 'Enter' || e.key === ',') {
                e.preventDefault();
                processRowTags(rowId, document.getElementById(`rowTagInput_${rowId}`).value);
                document.getElementById(`rowTagInput_${rowId}`).value = '';
            }
        }
        function handleRowTagPaste(e, rowId) {
            e.preventDefault();
            processRowTags(rowId, (e.clipboardData || window.clipboardData).getData('text'));
            document.getElementById(`rowTagInput_${rowId}`).value = '';
        }
        function processRowTags(rowId, str) {
            let arr = window[`rowTags_${rowId}`];
            str.split(',').forEach(part => {
                let val = part.trim().replace(/^#+/, '');
                if (val && !arr.includes(val)) arr.push(val);
            });
            renderRowTags(rowId);
        }
        function renderRowTags(rowId) {
            let container = document.getElementById(`rowTagContainer_${rowId}`);
            let arr = window[`rowTags_${rowId}`];
            container.innerHTML = '';
            arr.forEach((tag, idx) => {
                let span = document.createElement('span');
                span.className = "bg-green-100 text-green-700 text-[9px] px-1.5 py-0.5 rounded flex items-center gap-1 font-medium";
                span.innerHTML = `${tag} <button type="button" onclick="removeRowTag(${rowId}, ${idx})" class="text-red-500 font-bold ml-1">×</button>`;
                container.appendChild(span);
            });
            document.getElementById(`rowHiddenTags_${rowId}`).value = arr.join(', ');
        }
        function removeRowTag(rowId, idx) { window[`rowTags_${rowId}`].splice(idx, 1); renderRowTags(rowId); }

        window.addEventListener('click', function(e) {
            if (!document.getElementById('uploadCatInput').contains(e.target) && !document.getElementById('uploadCatDropdown').contains(e.target)) {
                document.getElementById('uploadCatDropdown').classList.add('hidden');
            }
            if (!document.getElementById('batchCatInput').contains(e.target) && !document.getElementById('batchCatDropdown').contains(e.target)) {
                document.getElementById('batchCatDropdown').classList.add('hidden');
            }
            document.querySelectorAll("[id^='rowCatDropdown_']").forEach(drop => {
                let rowId = drop.id.split('_')[1];
                let input = document.getElementById(`rowCatInput_${rowId}`);
                if (input && !input.contains(e.target) && !drop.contains(e.target)) drop.classList.add('hidden');
            });
        });

        window.addEventListener('DOMContentLoaded', () => { addDynamicRow(); });
    </script>
</body>
</html>