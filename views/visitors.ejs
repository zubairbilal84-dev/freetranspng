<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Admin Panel</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-100 font-sans">
    
    <header class="bg-gray-900 text-white p-4 flex justify-between items-center shadow">
        <h1 class="text-xl font-bold"><%= title %></h1>
        <a href="/admin" class="bg-gray-700 px-4 py-2 rounded text-sm hover:bg-gray-600 font-medium">← Back to Dashboard</a>
    </header>

    <main class="container mx-auto p-6">
        <div class="bg-white p-6 rounded-xl shadow">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-200 text-gray-700 text-sm">
                            <th class="p-3">#</th>
                            <th class="p-3">Visitor IP</th>
                            <th class="p-3">Country</th>
                            <th class="p-3">Timestamp (Date & Time)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 text-sm">
                        <% if(visitors.length > 0) { %>
                            <% visitors.forEach((v, index) => { %>
                                <tr class="hover:bg-gray-50">
                                    <td class="p-3 text-gray-500 font-semibold"><%= index + 1 %></td>
                                    <td class="p-3 font-mono text-gray-800"><%= v.ip %></td>
                                    <td class="p-3 font-medium text-indigo-600"><%= v.country %></td>
                                    <td class="p-3 text-gray-600"><%= new Date(v.timestamp).toLocaleString() %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="p-4 text-center text-gray-500">No visitors found for this period.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</body>
</html>